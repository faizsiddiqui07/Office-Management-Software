{
  "extends": [
    "next/core-web-vitals"
  ],
  "overrides": [
    {
      "files": [
        "components/ui/**/*.{js,jsx}"
      ],
      "rules": {
        "no-unused-vars": "off",
        "react-hooks/exhaustive-deps": "off",
        "react/no-unescaped-entities": "off",
        "prefer-const": "off"
      }
    }
  ],
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "no-undef": "error"
  }
}
